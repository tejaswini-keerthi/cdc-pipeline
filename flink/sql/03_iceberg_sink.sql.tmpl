-- =============================================================================
-- STEP 5 job: write the deduplicated upsert streams to Apache Iceberg (MinIO),
-- with exactly-once delivery via Flink checkpoint -> Iceberg snapshot commits.
--
-- This is a TEMPLATE: ${VAR} placeholders are rendered from .env by the submit
-- script into .gen/03_iceberg_sink.sql (gitignored) so no secrets are committed.
--
-- Catalog: JdbcCatalog backed by Postgres (atomic metadata commits).
-- Storage: S3FileIO against MinIO (path-style access required).
-- =============================================================================

CREATE CATALOG iceberg WITH (
    'type' = 'iceberg',
    'catalog-impl' = 'org.apache.iceberg.jdbc.JdbcCatalog',
    'uri' = 'jdbc:postgresql://postgres:5432/iceberg_catalog',
    'jdbc.user' = '${POSTGRES_USER}',
    'jdbc.password' = '${POSTGRES_PASSWORD}',
    'warehouse' = 's3://warehouse/iceberg',
    'io-impl' = 'org.apache.iceberg.aws.s3.S3FileIO',
    's3.endpoint' = 'http://minio:9000',
    's3.path-style-access' = 'true',
    's3.access-key-id' = '${MINIO_ROOT_USER}',
    's3.secret-access-key' = '${MINIO_ROOT_PASSWORD}',
    'client.region' = 'us-east-1'
);

-- Namespace for the replicated tables.
CREATE DATABASE IF NOT EXISTS iceberg.cdc;

-- ---- Iceberg target tables (v2 + upsert) -----------------------------------
-- format-version=2 enables row-level deletes; write.upsert.enabled makes the
-- sink emit equality deletes keyed by the PRIMARY KEY (the identifier fields).
CREATE TABLE IF NOT EXISTS iceberg.cdc.customers (
    customer_id INT,
    first_name  STRING,
    last_name   STRING,
    email       STRING,
    phone       STRING,
    pk_fingerprint      STRING,
    content_fingerprint STRING,
    PRIMARY KEY (customer_id) NOT ENFORCED
) WITH ('format-version' = '2', 'write.upsert.enabled' = 'true');

CREATE TABLE IF NOT EXISTS iceberg.cdc.products (
    product_id     INT,
    sku            STRING,
    name           STRING,
    category       STRING,
    price          DOUBLE,
    stock_quantity INT,
    pk_fingerprint      STRING,
    content_fingerprint STRING,
    PRIMARY KEY (product_id) NOT ENFORCED
) WITH ('format-version' = '2', 'write.upsert.enabled' = 'true');

CREATE TABLE IF NOT EXISTS iceberg.cdc.orders (
    order_id     INT,
    customer_id  INT,
    status       STRING,
    total_amount DOUBLE,
    pk_fingerprint      STRING,
    content_fingerprint STRING,
    PRIMARY KEY (order_id) NOT ENFORCED
) WITH ('format-version' = '2', 'write.upsert.enabled' = 'true');

CREATE TABLE IF NOT EXISTS iceberg.cdc.order_items (
    order_item_id INT,
    order_id      INT,
    product_id    INT,
    quantity      INT,
    unit_price    DOUBLE,
    pk_fingerprint      STRING,
    content_fingerprint STRING,
    PRIMARY KEY (order_item_id) NOT ENFORCED
) WITH ('format-version' = '2', 'write.upsert.enabled' = 'true');

-- ---- single job: all four upserts into Iceberg -----------------------------
-- Sources (customers_src, ...) come from 01_sources.sql in the default catalog,
-- referenced unqualified; Iceberg targets are fully qualified.
EXECUTE STATEMENT SET
BEGIN
    INSERT INTO iceberg.cdc.customers
    SELECT
        customer_id, first_name, last_name, email, phone,
        MD5(CAST(customer_id AS STRING)) AS pk_fingerprint,
        MD5(CONCAT_WS('|',
            COALESCE(first_name, ''), COALESCE(last_name, ''),
            COALESCE(email, ''), COALESCE(phone, ''))) AS content_fingerprint
    FROM customers_src;

    INSERT INTO iceberg.cdc.products
    SELECT
        product_id, sku, name, category, price, stock_quantity,
        MD5(CAST(product_id AS STRING)) AS pk_fingerprint,
        MD5(CONCAT_WS('|',
            COALESCE(sku, ''), COALESCE(name, ''), COALESCE(category, ''),
            CAST(price AS STRING), CAST(stock_quantity AS STRING))) AS content_fingerprint
    FROM products_src;

    INSERT INTO iceberg.cdc.orders
    SELECT
        order_id, customer_id, status, total_amount,
        MD5(CAST(order_id AS STRING)) AS pk_fingerprint,
        MD5(CONCAT_WS('|',
            CAST(customer_id AS STRING), COALESCE(status, ''),
            CAST(total_amount AS STRING))) AS content_fingerprint
    FROM orders_src;

    INSERT INTO iceberg.cdc.order_items
    SELECT
        order_item_id, order_id, product_id, quantity, unit_price,
        MD5(CAST(order_item_id AS STRING)) AS pk_fingerprint,
        MD5(CONCAT_WS('|',
            CAST(order_id AS STRING), CAST(product_id AS STRING),
            CAST(quantity AS STRING), CAST(unit_price AS STRING))) AS content_fingerprint
    FROM order_items_src;
END;
